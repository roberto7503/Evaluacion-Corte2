<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>

<Pane prefHeight="650.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.evaluacioncorte2.controller.ProductoController">

    <Label layoutX="20.0" layoutY="20.0" text="Buscar:" />
    <TextField fx:id="txtBuscar" layoutX="70.0" layoutY="16.0" prefWidth="150.0" promptText="Nombre o código..." />

    <Label layoutX="235.0" layoutY="20.0" text="Categoría:" />
    <ComboBox fx:id="cmbFiltroCategoria" layoutX="300.0" layoutY="16.0" prefWidth="120.0" />

    <CheckBox fx:id="chkSoloStock" layoutX="435.0" layoutY="20.0" text="Solo con existencias" />

    <Button fx:id="btnBuscar" layoutX="585.0" layoutY="16.0" onAction="#accionBuscar" text="Buscar" />
    <Button fx:id="btnLimpiarFiltros" layoutX="645.0" layoutY="16.0" onAction="#accionLimpiarFiltros" text="Limpiar filtros" />
    <Button fx:id="btnRecargar" layoutX="745.0" layoutY="16.0" onAction="#accionRecargar" text="Recargar" />
    <Label layoutX="20.0" layoutY="65.0" text="ID:" />
    <TextField fx:id="txtId" disable="true" editable="false" layoutX="70.0" layoutY="61.0" prefWidth="100.0" promptText="Autogenerado" />

    <Label layoutX="235.0" layoutY="65.0" text="Código:" />
    <TextField fx:id="txtCodigo" layoutX="300.0" layoutY="61.0" prefWidth="150.0" promptText="Ej. P001" />

    <Label layoutX="480.0" layoutY="65.0" text="Categoría:" />
    <ComboBox fx:id="cmbCategoria" layoutX="550.0" layoutY="61.0" prefWidth="160.0" promptText="Seleccione..." />
    <Label layoutX="20.0" layoutY="105.0" text="Nombre:" />
    <TextField fx:id="txtNombre" layoutX="70.0" layoutY="101.0" prefWidth="380.0" promptText="Nombre del producto" />

    <Label layoutX="480.0" layoutY="105.0" text="Precio:" />
    <TextField fx:id="txtPrecio" layoutX="550.0" layoutY="101.0" prefWidth="90.0" promptText="0.00" />

    <Label layoutX="660.0" layoutY="105.0" text="Stock:" />
    <TextField fx:id="txtStock" layoutX="705.0" layoutY="101.0" prefWidth="90.0" promptText="0" />
    <Button fx:id="btnNuevo" layoutX="70.0" layoutY="145.0" onAction="#accionLimpiarFormulario" text="Nuevo / Limpiar" />
    <Button fx:id="btnGuardar" layoutX="195.0" layoutY="145.0" onAction="#accionGuardar" text="Guardar" />
    <Button fx:id="btnActualizar" layoutX="270.0" layoutY="145.0" onAction="#accionActualizar" text="Actualizar" />
    <Button fx:id="btnEliminar" layoutX="355.0" layoutY="145.0" onAction="#accionEliminar" text="Eliminar" />
    <TableView fx:id="tblProductos" layoutX="20.0" layoutY="190.0" prefHeight="410.0" prefWidth="810.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="270.0" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="130.0" text="Categoría" />
            <TableColumn fx:id="colPrecio" prefWidth="130.0" text="Precio (C$)" />
            <TableColumn fx:id="colStock" prefWidth="118.0" text="Stock" />
        </columns>
    </TableView>

    <Label fx:id="lblContador" layoutX="670.0" layoutY="615.0" style="-fx-font-weight: bold;" text="Registros visibles: 0" />

</Pane>